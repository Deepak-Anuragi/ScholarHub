# Dependencies
node_modules/

# Build output
dist/
.next/
out/
build/
*.tsbuildinfo

# Written into web/public by next-sitemap, which runs on every web build.
# Committing them means an unrelated build shows up as a diff of timestamps.
web/public/robots.txt
web/public/sitemap.xml
web/public/sitemap-*.xml

# Environment — never commit real secrets, only the .env.example templates
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor and local tooling config (per-developer, not project state)
.vscode/
.idea/
*.swp
CLAUDE.md
AGENTS.md
.cursorrules
.cursor/

# Planning documents belong outside the repo, not in version control
PLAN.md
ROADMAP.md
*-plan.md
*_PLAN.md
PHASE_*.md

# OS
.DS_Store
Thumbs.db

# Deployment
.vercel
