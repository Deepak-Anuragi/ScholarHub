{
  "name": "scholarshub-server",
  "version": "1.0.0",
  "description": "ScholarHub Express API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm install --include=dev && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": "20.x || 22.x"
  },
  "dependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "bcryptjs": "3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "9.7.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.7",
    "razorpay": "2.9.6",
    "socket.io": "^4.8.3",
    "typescript": "5.6.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "4.19.2",
    "vitest": "^4.1.11"
  }
}
