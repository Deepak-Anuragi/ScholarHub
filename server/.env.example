# ── Server Configuration ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database (MongoDB) ─────────────────────────────────────────────────────
# Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/scholarshub?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/scholarshub
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/scholarshub?retryWrites=true&w=majority"
MONGODB_DB="scholarshub"

# ── Frontend URL (for CORS) ────────────────────────────────────────────────
# In production, set to your frontend domain(s) (comma-separated if multiple):
# e.g. CLIENT_URL="https://scholarshub.in,https://www.scholarshub.in"
CLIENT_URL="http://localhost:3000"

# ── JWT Authentication ─────────────────────────────────────────────────────
# REQUIRED. The server refuses to start without it — sessions are signed with
# this key and an unsigned session is forgeable.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The SAME value must be set in web/.env.local so Server Components can verify
# the cookie. Never expose it as a NEXT_PUBLIC_ variable.
JWT_SECRET="replace-with-a-secure-random-secret-key"
JWT_EXPIRES_IN="30d"

# ── Admin signup ───────────────────────────────────────────────────────────
# REQUIRED for POST /api/auth/signup/admin. Without it every admin signup
# attempt returns 403 with no other explanation.
ADMIN_SECRET_KEY=""

# ── Razorpay Payment Gateway ───────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ── Cloudinary (Image Uploads) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
