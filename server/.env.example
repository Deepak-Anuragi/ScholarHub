# ── Server Configuration ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database (MongoDB) ─────────────────────────────────────────────────────
# Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/scholarshub?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/scholarshub
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/scholarshub?retryWrites=true&w=majority"

# ── Frontend URL (for CORS) ────────────────────────────────────────────────
# In production, set to your frontend domain(s) (comma-separated if multiple):
# e.g. CLIENT_URL="https://scholarshub.in,https://www.scholarshub.in"
CLIENT_URL="http://localhost:3000"

# ── JWT Authentication ─────────────────────────────────────────────────────
# REQUIRED. The server refuses to start without it — sessions are signed with
# this key and an unsigned session is forgeable.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The SAME value must be set in web/.env.local so Server Components can verify
# the cookie. Never expose it as a NEXT_PUBLIC_ variable.
JWT_SECRET="replace-with-a-secure-random-secret-key"
JWT_EXPIRES_IN="30d"

# ── Admin signup ───────────────────────────────────────────────────────────
# REQUIRED for POST /api/auth/signup/admin. Without it every admin signup
# attempt returns 403 with no other explanation.
ADMIN_SECRET_KEY=""

# ── Pricing ────────────────────────────────────────────────────────────────
# Optional. Platform commission as a decimal fraction, charged to the student
# on top of the library's fee; the owner is paid the library fee in full.
# Defaults to 0.02 (2%). Must be >= 0 and < 1, or it is ignored with a warning.
# Keep PLATFORM_RATE in web/src/lib/pricing.ts in sync so the breakdown shown
# before checkout matches what is charged.
PLATFORM_RATE="0.02"

# ── Razorpay Payment Gateway ───────────────────────────────────────────────
# Optional in development: leave blank and booking falls back to mock orders.
# Both are REQUIRED in production — a real order cannot be confirmed without
# the secret, and mock orders are rejected when NODE_ENV=production.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ── Cloudinary (owner library photos) ──────────────────────────────────────
# All three are required for photo upload. Without them the owner dashboard's
# signature endpoint answers 503 and no photo can be added — deliberately, so
# a misconfigured deploy cannot quietly store URLs it never uploaded.
# The API secret signs each upload; it must never be exposed to the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email (Nodemailer) ─────────────────────────────────────────────────────
# Optional. Without SMTP_HOST and SMTP_USER the mailer is disabled and seat
# alerts are delivered in-app only, with no error.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" for port 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""                 # defaults to SMTP_USER when blank
