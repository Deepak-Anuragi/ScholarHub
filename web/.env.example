# ── URLs ───────────────────────────────────────────────────────────────────
# Where the Express API lives. Used for server-side (SSR) fetches; browser
# requests go to same-origin /api/* and are rewritten by next.config.ts.
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Session verification ───────────────────────────────────────────────────
# REQUIRED. Must be the SAME value as JWT_SECRET in server/.env.
# Server Components (lib/auth-session.ts) verify the session cookie with it to
# guard the dashboard layouts. This package only ever verifies, never signs.
# Deliberately NOT prefixed NEXT_PUBLIC_ — it must never reach the browser.
JWT_SECRET=""

# ── Google Maps ────────────────────────────────────────────────────────────
# Used by the /map page. Restrict the key by HTTP referrer in the Google
# console — anything NEXT_PUBLIC_ is visible to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ── Cloudinary (owner photo upload) ────────────────────────────────────────
# Optional. When blank, the owner dashboard stores a placeholder URL instead
# of uploading. Uploads currently go straight from the browser using the
# unsigned "scholarshub" preset, so no API secret is needed here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# NOTE: there is no NEXT_PUBLIC_RAZORPAY_KEY_ID. The checkout key is returned
# by POST /api/bookings/create-order as razorpay_key_id, so the frontend never
# needs its own copy.
